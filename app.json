{
  "expo": {
    "name": "MOTION",
    "slug": "calories-counter-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "motion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dionose.motion",
      "infoPlist": {
        "NSCameraUsageDescription": "MOTION uses your camera to photograph meals so it can estimate their calories.",
        "NSPhotoLibraryUsageDescription": "MOTION lets you pick a photo of a meal you've already taken, so you can log it later.",
        "NSMicrophoneUsageDescription": "MOTION lets you describe a meal out loud when a photo alone isn't enough.",
        "NSSpeechRecognitionUsageDescription": "MOTION turns what you say into text on your phone, so you can describe a meal out loud instead of typing it.",
        "NSHealthShareUsageDescription": "MOTION reads your steps, active minutes and calories burned so your daily numbers reflect what you actually did.",
        "NSHealthUpdateUsageDescription": "MOTION never writes to Health. This permission is required by iOS even for read-only access.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dionose.motion",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-camera",
      "expo-notifications",
      "expo-apple-authentication",
      "react-native-health-connect",
      "@kingstinct/react-native-healthkit",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f4ffda77-3678-402e-8b6a-47a77a8da342"
      }
    },
    "owner": "dionose"
  }
}